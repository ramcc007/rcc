# ── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""   # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"   # change to your Netlify URL in production

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://YOUR-SITE.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Encryption key (for per-user Gemini API keys stored in DB) ───────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""    # must be exactly 64 hex characters

# ── Database (Turso) ─────────────────────────────────────────────────────────
# Local dev: leave blank — defaults to file:./dev.db (no sign-up needed)
# Production: create a free DB at https://turso.tech and paste credentials below
TURSO_DATABASE_URL=""   # e.g. libsql://my-db-username.turso.io
TURSO_AUTH_TOKEN=""     # from: turso db tokens create my-db

# ── Note ─────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY is NOT here — each user enters their own key in Settings.
