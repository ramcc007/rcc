generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  image              String?
  emailVerified      DateTime?
  encryptedGeminiKey String?
  defaultPlatform    String?   @default("tiktok")
  defaultAspectRatio String?   @default("9:16")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  brandKits  BrandKit[]
  campaigns  Campaign[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BrandKit {
  id             String   @id @default(cuid())
  userId         String
  name           String
  primaryColor   String?
  secondaryColor String?
  logoUrl        String?
  watermarkUrl   String?
  fontFamily     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productImages BrandAsset[]
  campaigns     Campaign[]
}

model BrandAsset {
  id         String   @id @default(cuid())
  brandKitId String
  name       String
  url        String
  type       String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String   @id @default(cuid())
  userId          String
  brandKitId      String?
  name            String
  productName     String
  productCategory String
  targetAudience  String
  brandVoice      String?
  competitorNames String?
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandKit BrandKit? @relation(fields: [brandKitId], references: [id])
  scripts  Script[]
}

model Script {
  id          String   @id @default(cuid())
  campaignId  String
  hookType    String
  funnelStage String
  ctaType     String
  tone        String
  platform    String
  duration    Int
  persona     String
  content     String
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  videoJobs VideoJob[]
}

model VideoJob {
  id                 String   @id @default(cuid())
  scriptId           String
  aspectRatio        String
  resolution         String   @default("1080p")
  characterDesc      String?
  referenceImageUrls String?
  veoJobId           String?
  veoOperationName   String?
  status             String   @default("queued")
  outputUrl          String?
  thumbnailUrl       String?
  durationActual     Float?
  fileSizeBytes      Int?
  qualityScore       Float?
  qualityReport      String?
  complianceScore    Float?
  complianceReport   String?
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  script  Script        @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  exports VideoExport[]
}

model VideoExport {
  id           String   @id @default(cuid())
  videoJobId   String
  format       String
  resolution   String
  platform     String?
  withOverlays Boolean  @default(true)
  exportedUrl  String
  createdAt    DateTime @default(now())

  videoJob VideoJob @relation(fields: [videoJobId], references: [id], onDelete: Cascade)
}
